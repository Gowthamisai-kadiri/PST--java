class Solution {
public:
    int removeElement(vector<int>& nums, int val) {
        int j = 0; // write pointer
        
        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] != val) {
                nums[j++] = nums[i]; // write valid element
            }
        }
        
        return j; // k = new length
    }
};
