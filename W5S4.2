#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    bool match(string word, string pattern) {
        unordered_map<char, char> mp;
        unordered_map<char, char> rev;

        for (int i = 0; i < pattern.length(); i++) {
            char p = pattern[i];
            char w = word[i];

            // pattern -> word mapping check
            if (mp.count(p)) {
                if (mp[p] != w)
                    return false;
            } else {
                mp[p] = w;
            }

            // word -> pattern mapping check
            if (rev.count(w)) {
                if (rev[w] != p)
                    return false;
            } else {
                rev[w] = p;
            }
        }

        return true;
    }

    vector<string> findAndReplacePattern(vector<string>& words, string pattern) {
        vector<string> ans;

        for (string word : words) {
            if (match(word, pattern)) {
                ans.push_back(word);
            }
        }

        return ans;
    }
};
