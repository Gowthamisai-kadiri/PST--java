#include <bits/stdc++.h>
using namespace std;

void matrixRotation(vector<vector<int>> matrix, int r) {
    int m = matrix.size();
    int n = matrix[0].size();

    int layers = min(m, n) / 2;

    for (int layer = 0; layer < layers; layer++) {

        vector<int> v;

        int top = layer;
        int left = layer;
        int bottom = m - layer - 1;
        int right = n - layer - 1;

        // Top row
        for (int j = left; j <= right; j++)
            v.push_back(matrix[top][j]);

        // Right column
        for (int i = top + 1; i <= bottom; i++)
            v.push_back(matrix[i][right]);

        // Bottom row
        for (int j = right - 1; j >= left; j--)
            v.push_back(matrix[bottom][j]);

        // Left column
        for (int i = bottom - 1; i > top; i--)
            v.push_back(matrix[i][left]);

        int len = v.size();
        int shift = r % len;

        int index = 0;

        // Put rotated values back
        // Anti-clockwise rotation
        for (int j = left; j <= right; j++) {
            matrix[top][j] = v[(shift + index) % len];
            index++;
        }

        for (int i = top + 1; i <= bottom; i++) {
            matrix[i][right] = v[(shift + index) % len];
            index++;
        }

        for (int j = right - 1; j >= left; j--) {
            matrix[bottom][j] = v[(shift + index) % len];
            index++;
        }

        for (int i = bottom - 1; i > top; i--) {
            matrix[i][left] = v[(shift + index) % len];
            index++;
        }
    }

    // Print matrix
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            cout << matrix[i][j];
            if (j != n - 1)
                cout << " ";
        }
        cout << endl;
    }
}

int main() {
    int m, n, r;
    cin >> m >> n >> r;

    vector<vector<int>> matrix(m, vector<int>(n));

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            cin >> matrix[i][j];
        }
    }

    matrixRotation(matrix, r);

    return 0;
}
