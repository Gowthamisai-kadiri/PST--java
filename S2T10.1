import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(); // total numbers
        int k = sc.nextInt(); // subarray size
        int[] nums = new int[n];
        for (int i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
        }

        System.out.println(maxUniqueInSubarray(nums, k));
    }

    public static int maxUniqueInSubarray(int[] nums, int k) {
        Map<Integer, Integer> freq = new HashMap<>();
        int maxUnique = 0;

        // Initialize first window
        for (int i = 0; i < k; i++) {
            freq.put(nums[i], freq.getOrDefault(nums[i], 0) + 1);
        }
        maxUnique = freq.size();

        // Slide the window
        for (int i = k; i < nums.length; i++) {
            // Remove outgoing element
            int outgoing = nums[i - k];
            freq.put(outgoing, freq.get(outgoing) - 1);
            if (freq.get(outgoing) == 0) {
                freq.remove(outgoing);
            }

            // Add incoming element
            int incoming = nums[i];
            freq.put(incoming, freq.getOrDefault(incoming, 0) + 1);

            // Update max unique count
            maxUnique = Math.max(maxUnique, freq.size());
        }

        return maxUnique;
    }
}
