#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        string s;
        cin >> s;

        int n = s.size();
        int a[26] = {0}, b[26] = {0};

        for (int i = 0; i < n / 2; i++)
            a[s[i] - 'a']++;

        for (int i = (n + 1) / 2; i < n; i++)
            b[s[i] - 'a']++;

        bool ok = true;

        for (int i = 0; i < 26; i++) {
            if (a[i] != b[i]) {
                ok = false;
                break;
            }
        }

        cout << (ok ? "YES" : "NO") << endl;
    }

    return 0;
}
