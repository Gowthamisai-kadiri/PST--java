class Solution {
public:
    vector<int> runningSum(vector<int>& nums) {
        // Handle empty case
        if (nums.empty()) return {};
        
        // In-place modification is efficient
        for (int i = 1; i < nums.size(); i++) {
            nums[i] += nums[i - 1];
        }
        
        return nums;
    }
};
