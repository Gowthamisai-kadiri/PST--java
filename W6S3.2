#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        vector<int> ans;

        if (s.length() < p.length())
            return ans;

        vector<int> need(26, 0);
        vector<int> window(26, 0);

        // Frequency of characters in p
        for (char c : p) {
            need[c - 'a']++;
        }

        int k = p.length();

        // First window
        for (int i = 0; i < k; i++) {
            window[s[i] - 'a']++;
        }

        if (window == need)
            ans.push_back(0);

        // Slide the window
        for (int i = k; i < s.length(); i++) {
            window[s[i] - 'a']++;       // Add new character
            window[s[i - k] - 'a']--;   // Remove old character

            if (window == need)
                ans.push_back(i - k + 1);
        }

        return ans;
    }
};
