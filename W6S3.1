#include <bits/stdc++.h>
using namespace std;

int marsExploration(string s) {
    int count = 0;

    for (int i = 0; i < s.length(); i++) {
        char expected = "SOS"[i % 3];

        if (s[i] != expected) {
            count++;
        }
    }

    return count;
}

int main() {
    string s;
    cin >> s;

    cout << marsExploration(s) << endl;

    return 0;
}
