#include <bits/stdc++.h>
using namespace std;

int birthday(vector<int> s, int d, int m) {
    int n = s.size();
    int count = 0;
    int sum = 0;

    // First window
    for (int i = 0; i < m; i++) {
        sum += s[i];
    }

    if (sum == d) {
        count++;
    }

    // Slide the window
    for (int i = m; i < n; i++) {
        sum = sum - s[i - m] + s[i];

        if (sum == d) {
            count++;
        }
    }

    return count;
}

int main() {
    int n;
    cin >> n;

    vector<int> s(n);

    for (int i = 0; i < n; i++) {
        cin >> s[i];
    }

    int d, m;
    cin >> d >> m;

    cout << birthday(s, d, m) << endl;

    return 0;
}
