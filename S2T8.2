class Solution {
public:
    int largestAltitude(vector<int>& gain) {
        int currentAltitude = 0;  // Start altitude
        int maxAltitude = 0;      // Track the highest point
        
        for (int g : gain) {
            currentAltitude += g;     // Update altitude after each segment
            maxAltitude = max(maxAltitude, currentAltitude);  // Track maximum
        }
        
        return maxAltitude;
    }
};
